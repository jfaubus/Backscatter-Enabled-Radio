//     pinctrl-names = "default";                         /* Only "default" needed if no sleep state */
//     cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;              /* Chip-select via GPIO2 pin 5, active-low */

//     sensor0: sensor@0 {
//         compatible = "vnd,spi-device";                 /* Binds node to a Zephyr driver binding */
//         reg = <0>;                                     /* Chip-select index 0 on this bus */
//         spi-max-frequency = <4000000>;                  /* Cap SPI clock at 4 MHz for this device */
//         label = "SENSOR0";                              /* Runtime name via device_get_binding() */
//     };
// };

/*
 * A child node does not inherit its parent's disabled status, so the flash
 * node has to be turned off by hand. Without this,
 * CONFIG_DT_HAS_NORDIC_QSPI_NOR_ENABLED stays set and simply enabling
 * CONFIG_FLASH later would silently instantiate a driver that fights us for
 * the peripheral
 */
&mx25r64 {
	status = "disabled";
};
