/*
 * nRF52840dk overlay for QSPI
 *
 *  QSPI is taken away from Zephyr and given to the application.
 *     Disabling the node removes both the nordic,qspi-nor flash driver and
 *     the mx25r64 child, so nrfx_qspi can own the peripheral outright. The
 *     pins are then selected at runtime (see src/qspi_pattern.c) onto the
 *     Arduino header instead of the onboard MX25R6435F, so the signals can
 *     be probed and so that each burst is not a real page program into the
 *     flash (wear, plus a WIP-busy stall between bursts).
 *			this is really more relevant on the dev kit which has an external
 *			flash hooked up to the QSPI bus
 *
 *     CONFIG_NRFX_QSPI only depends on the node *existing*, not on it being
 *     enabled, so disabling it here does not disable the nrfx driver.
 */

// disable this so I can drive the code directly through nrfx_qspi. sorry Zephyr...
&qspi {
	status = "disabled";
};


// &spi20 {
