/*
 * A child node does not inherit its parent's disabled status, so the flash
 * node has to be turned off by hand. Without this,
 * CONFIG_DT_HAS_NORDIC_QSPI_NOR_ENABLED stays set and simply enabling
 * CONFIG_FLASH later would silently instantiate a driver that fights us for
 * the peripheral
 */
&mx25r64 {
	status = "disabled";
};


// use the nRF52840's internal 32 kHz RC oscillator instead of the external 32.768 kHz crystal
// on newer Zephyr this is set in devicetree, not with CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC
// (500 ppm accuracy is what the binding recommends for RC on nRF52)
&lfclk {
    k32src = "rc";
    k32src-accuracy-ppm = <500>;
};
