/*
 * nRF52840dk overlay for QSPI
 *
 *  QSPI is taken away from Zephyr and given to the application.
 *     Disabling the node removes both the nordic,qspi-nor flash driver and
 *     the mx25r64 child, so nrfx_qspi can own the peripheral outright. The
 *     pins are selected at runtime (see src/qspi_pattern.c) from the
 *     zephyr,user node below.
 *			on the dev kit these are the onboard MX25R6435F's pins, so each
 *			burst also reaches that flash unless it is cut off the bus
 *
 *     CONFIG_NRFX_QSPI only depends on the node *existing*, not on it being
 *     enabled, so disabling it here does not disable the nrfx driver.
 */

/*
 * RF switch pin map, read by src/board_pins.h. These are the wearable PCB's
 * dedicated QSPI pins; the DK is wired the same way.
 *
 * QSPI needs CSN, IO0 and IO1 assigned even though nothing listens to them:
 * CSN and IO0 are driven during every burst, and IO1 is read during
 * activation (see qspi_idle_pulldown_apply()). They are unconnected on the
 * PCB.
 *
 *   P0.19   QSPI SCK   (QSPI_CLK, test point only)
 *   P0.17   QSPI CSN   (unconnected)
 *   P0.20   QSPI IO0   (unconnected)
 *   P0.21   QSPI IO1   (unconnected)
 *   P0.22   QSPI IO2 = Mod_Sel0
 *   P0.23   QSPI IO3 = Mod_Sel1
 *   P0.24   CTRL_SPDT  (high drive, set in rf_switch.c)
 */
/ {
	zephyr,user {
		qspi-sck-gpios = <&gpio0 19 0>;
		qspi-csn-gpios = <&gpio0 17 0>;
		qspi-io0-gpios = <&gpio0 20 0>;
		qspi-io1-gpios = <&gpio0 21 0>;
		qspi-io2-gpios = <&gpio0 22 0>;
		qspi-io3-gpios = <&gpio0 23 0>;
		ctrl-spdt-gpios = <&gpio0 24 0>;
	};
};

// disable this so I can drive the code directly through nrfx_qspi. sorry Zephyr...
&qspi {
	status = "disabled";
};


