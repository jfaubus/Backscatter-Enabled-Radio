/*
 * nRF52840dk overlay for the PPI fork demo: TIMER2 + GPIOTE + PPI are enabled.
 */

// &spi20 {
//     status = "okay";                                  /* Enable the SPI20 peripheral */
//     pinctrl-0 = <&spi20_default>;                      /* Required: default pin config */
//     pinctrl-names = "default";                         /* Only "default" needed if no sleep state */
//     cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;              /* Chip-select via GPIO2 pin 5, active-low */

//     sensor0: sensor@0 {
//         compatible = "vnd,spi-device";                 /* Binds node to a Zephyr driver binding */
//         reg = <0>;                                     /* Chip-select index 0 on this bus */
//         spi-max-frequency = <4000000>;                  /* Cap SPI clock at 4 MHz for this device */
//         label = "SENSOR0";                              /* Runtime name via device_get_binding() */
//     };
// };

&ppi {
	status = "okay";
};

&gpiote {
	status = "okay";
};

/*
 * TIMER2 rather than TIMER0/TIMER1: TIMER0 is claimed by the SoftDevice /
 * Bluetooth controller if one is ever added to this project, and TIMER1 is a
 * common default elsewhere. Nothing in Zephyr binds to this node -> it is
 * enabled purely so the resource is visibly reserved in the devicetree.
 */
&timer2 {
	status = "okay";
};
